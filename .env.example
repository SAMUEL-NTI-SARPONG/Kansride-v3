# === Application ===
NODE_ENV=development
APP_PORT=3000

# === Database (PostgreSQL + PostGIS) ===
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kansride
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/kansride

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_ACCESS_SECRET=change-this-to-a-strong-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production

# === SMS Provider (mock in development) ===
# Supported: mock, hubtel. Other values fail fast at config load.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
# Hubtel adapter reads these directly (required in production when SMS_PROVIDER=hubtel).
HUBTEL_SMS_API_KEY=
HUBTEL_SENDER_ID=KansRide

# === Maps ===
# openstreetmap uses the deterministic Haversine development adapter.
# google is reserved until a concrete adapter and key are supplied.
MAPS_PROVIDER=openstreetmap
MAPS_API_KEY=

# === Payments ===
# mock is deterministic development-only mode. Production rejects mock.
# momo remains unavailable until the provider adapter and owner credentials exist.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# === Web CORS ===
# Optional comma-separated list of allowed origins for admin-web / tracking-web.
# When set, credentials are enabled and only these origins are accepted.
# When unset (default), any origin is accepted without credentials.
WEB_CORS_ORIGINS=

# === Logging ===
LOG_LEVEL=debug

# === Client / public (defaults shown; no secrets) ===
# Set EXPO_PUBLIC_DEVICE_MODE=physical for a real phone. In that mode all
# Expo API/WebSocket/tracking URLs must be reachable LAN or HTTPS URLs; the
# mobile clients reject localhost and loopback values at startup.
# EXPO_PUBLIC_DEVICE_MODE=simulator
# apps/mobile-passenger
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# EXPO_PUBLIC_WS_URL=http://localhost:3000
# EXPO_PUBLIC_TRACKING_URL=http://localhost:3002
# apps/mobile-driver
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# EXPO_PUBLIC_WS_URL=http://localhost:3000
# For a physical Android device, replace localhost with the development
# computer LAN address, for example:
# EXPO_PUBLIC_DEVICE_MODE=physical
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1
# EXPO_PUBLIC_WS_URL=http://192.168.1.20:3000
# EXPO_PUBLIC_TRACKING_URL=http://192.168.1.20:3002
# apps/admin-web
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# apps/tracking-web
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
