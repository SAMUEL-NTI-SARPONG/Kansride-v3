# === Application ===
NODE_ENV=development
APP_PORT=3001

# === Database (PostgreSQL + PostGIS) ===
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kansride
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kansride

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_ACCESS_SECRET=change-this-to-a-strong-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production

# === SMS Provider (mock in development) ===
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=

# === Maps ===
MAPS_PROVIDER=openstreetmap
MAPS_API_KEY=

# === Logging ===
LOG_LEVEL=debug
