{
  "name": "kansride",
  "version": "0.1.0",
  "private": true,
  "description": "KansRide: Tricycle ride-hailing platform for Ghana",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:all": "node tools/dev-all.cjs",
    "doctor": "node tools/doctor.cjs",
    "seed:demo": "node tools/seed-demo.cjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify:v1": "node tools/verify-v1.cjs",
    "test:workspace": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
